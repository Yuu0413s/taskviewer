# Neon PostgreSQL の接続文字列
# Neon のダッシュボード → Connection Details からコピー
POSTGRES_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js のセッション署名用シークレット
# 生成: npx auth secret
AUTH_SECRET=""

# アプリのURL（ローカルは http://localhost:3000）
NEXTAUTH_URL="http://localhost:3000"

# Googleログイン用（Google Cloud Console → APIとサービス → 認証情報 で発行）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== ここから下は Web Push 実装後に必要 =====

# Web Push の VAPID 鍵ペア
# 生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"

# cron エンドポイント（/api/cron/check-alarms）の認証用トークン
# 生成: openssl rand -base64 32
CRON_SECRET=""
